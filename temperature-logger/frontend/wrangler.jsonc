{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "temperature-monitor",
  "main": "./src/index.js",
  "compatibility_date": "2026-10-22",
  "assets": {
    "directory": "./dist",
    "html_handling": "drop-trailing-slash",
    "not_found_handling": "404-page",
    "run_worker_first": ["/health", "/api/*"]
  },
  "vars": {
    "PUBLIC_API_ENABLED": "false"
  },
  "ratelimits": [
    {
      "name": "API_RATE_LIMIT",
      "namespace_id": "20261022",
      "simple": { "limit": 120, "period": 60 }
    }
  ]
  // When the Cloudflare VPC Service is created, add:
  // "vpc_services": [
  //   { "binding": "PI_API", "service_id": "<actual-service-id>", "remote": true }
  // ]
}
